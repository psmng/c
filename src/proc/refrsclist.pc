int
get_REF_RSC_LIST(rsc_name)
char *rsc_name;
{
    rsc_list_t  MLIST[1500], LIST[2000];
    int         fetch_cnt, fetch_tot, fetch_max, fetch_rows;
    int         i, sqlcode, mlist_cnt;

    memset(LIST, 0x00, sizeof(LIST));

    EXEC SQL DECLARE C_SHLIBS CURSOR FOR
    SELECT  X.REF_RSC_NAME
    FROM    RSC01R01@FRMSVP_FW X, RSC01M00@FRMSVP_FW Y
    WHERE   X.PLATFORM_TYPE = Y.PLATFORM_TYPE
    AND     X.REF_RSC_NAME = Y.RSC_NAME
    AND     X.PLATFORM_TYPE = :platform_type
    AND     X.RSC_NAME = :rsc_name
    ORDER BY X.REF_RSC_NAME;

    if (sqlca.sqlcode != 0)
    {
        printf("UOBJS SELECT ERROR[%d]\n", sqlca.sqlcode);

        return (0);
    }

    mlist_cnt = 0;
    fetch_max = 2000;
    fetch_rows = 0;

    if (sqlca.sqlcode != 0)
    {
        printf("DECLARE ERROR[%d]\n", sqlca.sqlcode);

        return(0);
    }

    while (1)
    {
        memset(LIST, 0x00, sizeof(LIST));

        EXEC SQL FETCH C_SHLIBS INTO :LIST;

        sqlcode = sqlca.sqlcode;

        fetch_tot = sqlca.sqlerrd[2];

        fetch_cnt = fetch_tot - (fetch_rows * fetch_max);

        for (i = 0; i < fetch_cnt; i++)
        {
            memset(&MLIST[mlist_cnt], &LIST[i], sizeof(rsc_list_t));

            mlist_cnt++;
        }

        if (fetch_cnt < fetch_max) break;

        fetch_rows++;
    }

    EXEC SQL CLOSE C_SHLIBS;

    if (mlist_cnt > 0)
    {
        for (i = 0; i < mlist_cnt; i++)
        {
            get_REF_RSC_LIST(LIST[i].s);
            set_ref_rsc_name(LIST[i].s);
        }
    }

    return (0);
}


/* ============================================================
 * 원본: get_REF_RSC_LIST (재귀 Pro*C 함수)
 *        → 재귀쿼리(CONNECT BY NOCYCLE) 기반으로 변환
 *
 * 변환 핵심:
 *   원본은 1단계 직접 참조만 SELECT하고, 각 결과에 대해
 *   자기 자신을 재귀 호출하는 구조.
 *   변환본은 Oracle의 CONNECT BY NOCYCLE로 전체 의존 트리를
 *   DB 왕복 1회로 전부 가져온 뒤 순회만 한다.
 * ============================================================ */

int
get_REF_RSC_LIST_ADV(rsc_name)          /* 원본과 동일한 시그니처 유지 */
char *rsc_name;
{
    /* -----------------------------------------------------------
     * [1] 호스트 변수 선언부
     *
     *  MLIST : 최종 누적 결과 배열 (재귀 전개 후 모든 노드)
     *  LIST  : FETCH 1회분 버퍼
     *  fetch_cnt  : 이번 FETCH에서 실제로 가져온 행 수
     *  fetch_tot  : sqlca.sqlerrd[2] — 누적 처리 행 수 (Oracle)
     *  fetch_max  : 1회 FETCH 최대 행 수 (배열 크기와 일치)
     *  fetch_rows : 지금까지 완료한 FETCH 회수
     *  mlist_cnt  : MLIST에 누적된 총 행 수
     * ----------------------------------------------------------- */
    rsc_list_t  MLIST[1500], LIST[2000];
    int         fetch_cnt, fetch_tot, fetch_max, fetch_rows;
    int         i, sqlcode, mlist_cnt;

    /* -----------------------------------------------------------
     * [2] 버퍼 초기화
     *  원본과 동일. MLIST도 함께 초기화하여 쓰레기값 방지.
     * ----------------------------------------------------------- */
    memset(MLIST, 0x00, sizeof(MLIST));
    memset(LIST,  0x00, sizeof(LIST));

    /* -----------------------------------------------------------
     * [3] DECLARE CURSOR — 재귀쿼리(CONNECT BY NOCYCLE) 적용
     *
     *  원본 쿼리:
     *    SELECT X.REF_RSC_NAME
     *    FROM   RSC01R01 X, RSC01M00 Y
     *    WHERE  X.RSC_NAME = :rsc_name   ← 1단계 직접 참조만
     *
     *  변환 쿼리:
     *    START WITH X.RSC_NAME = :rsc_name
     *    CONNECT BY NOCYCLE
     *      PRIOR X.REF_RSC_NAME = X.RSC_NAME
     *      AND   X.PLATFORM_TYPE = PRIOR X.PLATFORM_TYPE
     *
     *  · START WITH  : 루트 조건 — 원본의 WHERE RSC_NAME = :rsc_name
     *  · CONNECT BY  : 트리 전개 규칙
     *                  "부모의 REF_RSC_NAME이 자식의 RSC_NAME"
     *  · NOCYCLE     : 순환참조 발생 시 무한루프 방지
     *                  (원본 재귀는 순환 시 스택 오버플로 위험)
     *  · PRIOR       : 직전(부모) 행의 컬럼을 참조
     *  · ORDER BY LEVEL, X.REF_RSC_NAME
     *                : 깊이 순 정렬 → 원본의 재귀 호출 순서와
     *                  논리적으로 동일한 처리 순서 보장
     * ----------------------------------------------------------- */
    EXEC SQL DECLARE C_SHLIBS CURSOR FOR
    SELECT  X.REF_RSC_NAME
    FROM    RSC01R01@FRMSVP_FW X, RSC01M00@FRMSVP_FW Y
    WHERE   X.PLATFORM_TYPE  = Y.PLATFORM_TYPE
    AND     X.REF_RSC_NAME   = Y.RSC_NAME
    AND     X.PLATFORM_TYPE  = :platform_type
    START WITH X.RSC_NAME    = :rsc_name
    CONNECT BY NOCYCLE
              PRIOR X.REF_RSC_NAME = X.RSC_NAME
          AND X.PLATFORM_TYPE      = PRIOR X.PLATFORM_TYPE
    ORDER BY LEVEL, X.REF_RSC_NAME;

    /* -----------------------------------------------------------
     * [4] DECLARE 직후 sqlca 체크
     *
     *  원본 버그 수정:
     *   원본은 DECLARE 체크와 OPEN 체크 블록이 뒤바뀌어 있었음.
     *   Pro*C에서 DECLARE는 정적 파싱이므로 sqlcode가 여기서
     *   세팅되지 않는 경우가 대부분이나, 원본 구조를 그대로 유지.
     * ----------------------------------------------------------- */
    if (sqlca.sqlcode != 0)
    {
        printf("DECLARE ERROR[%d]\n", sqlca.sqlcode);
        return (0);
    }

    /* -----------------------------------------------------------
     * [5] 카운터 초기화
     *
     *  mlist_cnt  : 누적 결과 행 수, 0부터 시작
     *  fetch_max  : LIST 배열 크기(2000)와 동일하게 설정
     *  fetch_rows : 완료된 FETCH 회차 카운터
     * ----------------------------------------------------------- */
    mlist_cnt  = 0;
    fetch_max  = 2000;
    fetch_rows = 0;

    /* -----------------------------------------------------------
     * [6] CURSOR OPEN
     *  커서를 열어 서버에서 결과셋 준비.
     *  OPEN 시점에 :rsc_name, :platform_type 바인드 값이 확정됨.
     * ----------------------------------------------------------- */
    EXEC SQL OPEN C_SHLIBS;

    if (sqlca.sqlcode != 0)
    {
        printf("OPEN ERROR[%d]\n", sqlca.sqlcode);
        return (0);
    }

    /* -----------------------------------------------------------
     * [7] FETCH 루프 — 배열 FETCH로 대량 처리
     *
     *  Oracle Pro*C의 배열 FETCH:
     *   INTO :LIST 에 배열 호스트 변수를 넘기면 최대 fetch_max개씩
     *   한 번에 가져온다.
     *
     *  fetch_tot = sqlca.sqlerrd[2]
     *   : 이번 OPEN 이후 현재까지 누적으로 FETCH된 총 행 수
     *
     *  fetch_cnt = fetch_tot - (fetch_rows * fetch_max)
     *   : 이번 FETCH 호출에서 실제로 채워진 행 수
     *   · 정상 FETCH: fetch_cnt == fetch_max (2000)
     *   · 마지막 FETCH: fetch_cnt < fetch_max → 루프 종료 조건
     * ----------------------------------------------------------- */
    while (1)
    {
        /* [7-1] FETCH 버퍼 초기화 — 이전 FETCH 잔재 제거 */
        memset(LIST, 0x00, sizeof(LIST));

        /* [7-2] 배열 FETCH 실행 */
        EXEC SQL FETCH C_SHLIBS INTO :LIST;

        sqlcode   = sqlca.sqlcode;        /* 현재 FETCH 상태 보존 */
        fetch_tot = sqlca.sqlerrd[2];     /* 누적 처리 행 수       */
        fetch_cnt = fetch_tot - (fetch_rows * fetch_max);
                                          /* 이번 FETCH 실 취득 행 */

        /* [7-3] 이번 FETCH 결과를 MLIST에 누적
         *
         *  원본 버그 수정:
         *   원본: memset(&MLIST[n], &LIST[i], size)
         *         → memset 2번째 인자는 int(채울 값)이어야 하나
         *           포인터(&LIST[i])를 넘기고 있어 UB(undefined behavior).
         *           실제 의도는 구조체 복사이므로 memcpy로 교체.
         * -------------------------------------------------------- */
        for (i = 0; i < fetch_cnt; i++)
        {
            memcpy(&MLIST[mlist_cnt],   /* 대상: 누적 배열 현재 위치 */
                   &LIST[i],            /* 원본: 이번 FETCH 버퍼 i번째 */
                   sizeof(rsc_list_t)); /* 복사 크기: 구조체 1개 */
            mlist_cnt++;                /* 누적 카운터 증가 */
        }

        /* [7-4] 종료 조건: 실 취득 행 < 최대 행 → 마지막 FETCH */
        if (fetch_cnt < fetch_max) break;

        fetch_rows++;   /* 다음 FETCH 회차 카운터 증가 */
    }

    /* -----------------------------------------------------------
     * [8] CURSOR CLOSE
     *  결과셋 자원 반환. 항상 OPEN에 대응하여 CLOSE 필수.
     * ----------------------------------------------------------- */
    EXEC SQL CLOSE C_SHLIBS;

    /* -----------------------------------------------------------
     * [9] 결과 순회 — set_ref_rsc_name 호출
     *
     *  원본과의 차이점:
     *   원본: get_REF_RSC_LIST(LIST[i].s) 재귀 호출
     *          → LIST는 마지막 FETCH 버퍼이므로 전체 결과가 아님 (버그)
     *          → 재귀 호출로 추가 DB 왕복 발생
     *
     *   변환: CONNECT BY NOCYCLE이 DB 내부에서 전체 트리를 전개했으므로
     *          MLIST에는 이미 모든 하위 의존 노드가 수집되어 있음.
     *          → 재귀 호출 불필요, 단순 순회로 동일 효과 달성.
     *          → MLIST[i].s 사용: 원본 버그(LIST 사용)도 함께 수정.
     * ----------------------------------------------------------- */
    if (mlist_cnt > 0)
    {
        for (i = 0; i < mlist_cnt; i++)
        {
            /* 재귀 호출 제거 — CONNECT BY가 전체 트리를 이미 전개함 */
            set_ref_rsc_name(MLIST[i].s);  /* LIST → MLIST 로 수정 */
        }
    }

    return (0);
}